#pragma code_page(65001)

#include "resource.h"
#include <windows.h>

IDI_APP ICON "..\\assets\\app.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "LanDrop"
            VALUE "FileDescription",  "内网快传 - 局域网文件传输"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "LanDrop"
            VALUE "LegalCopyright",   "LanDrop"
            VALUE "OriginalFilename", "LanDrop.exe"
            VALUE "ProductName",      "内网快传 LanDrop"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
